# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="AI-Based Real-Time Student Performance Prediction System"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# CORS Configuration (comma-separated origins)
# ==============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO

# ==============================================================================
# PostgreSQL Database Credentials
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=student_perf_db

DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@127.0.0.1:5432/student_perf_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
